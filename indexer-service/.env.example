# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=KB Indexer Service
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
# LOG_FORMAT options: "console" (human-readable, colored) or "json" (structured)
# Use "console" for development, "json" for production/log aggregation
LOG_FORMAT=console

# =============================================================================
# Worker Settings
# =============================================================================
MAX_CONCURRENT_JOBS=10
MESSAGE_VISIBILITY_TIMEOUT=300

# =============================================================================
# Storage Provider (Multi-Cloud Support)
# =============================================================================
# STORAGE_PROVIDER options: "azure", "aws", "gcp", "local"
STORAGE_PROVIDER=azure
STORAGE_CONTAINER_NAME=aksknowledgecurator

# Azure Blob Storage
AZURE_BLOB_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true

# AWS S3 (if using aws provider)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1

# =============================================================================
# Queue Provider (Multi-Cloud Support)
# =============================================================================
# QUEUE_PROVIDER options: "azure", "aws", "redis"
QUEUE_PROVIDER=azure

# Azure Storage Queue
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
INDEXING_QUEUE_NAME=kb-indexing-jobs
QUEUE_POLL_INTERVAL=5

# =============================================================================
# PostgreSQL Database
# =============================================================================
POSTGRESQL_DATABASE_HOST=localhost
POSTGRESQL_DATABASE_PORT=5432
POSTGRESQL_DATABASE_USER=postgres
POSTGRESQL_DATABASE_PASSWORD=dev123
POSTGRESQL_DATABASE_DATABASE=kbcurator

# =============================================================================
# Neo4j Graph Database
# =============================================================================
NEO4J_DATABASE_NEO4J_BOLT_URI=bolt://localhost:7687
NEO4J_DATABASE_NEO4J_USER=neo4j
NEO4J_DATABASE_NEO4J_PASSWORD=dev123

# =============================================================================
# Azure Document Intelligence
# =============================================================================
AZURE_DOC_INTELLIGENCE_ENDPOINT=https://your-instance.cognitiveservices.azure.com/
AZURE_DOC_INTELLIGENCE_KEY=your-key-here

# =============================================================================
# Azure OpenAI - LLM Model
# =============================================================================
AZURE_OPENAI_LLM_MODEL_API_KEY=your-api-key-here
AZURE_OPENAI_LLM_MODEL_API_BASE=https://your-instance.openai.azure.com/
AZURE_OPENAI_LLM_MODEL_API_VERSION=2024-02-15-preview
AZURE_OPENAI_LLM_MODEL_LLM_MODEL=gpt-4

# =============================================================================
# Azure OpenAI - Embedding Model
# =============================================================================
AZURE_OPENAI_EMBEDDING_MODEL_API_KEY=your-api-key-here
AZURE_OPENAI_EMBEDDING_MODEL_API_BASE=https://your-instance.openai.azure.com/
AZURE_OPENAI_EMBEDDING_MODEL_API_VERSION=2024-02-15-preview
AZURE_OPENAI_EMBEDDING_MODEL_EMBEDDING_MODEL=text-embedding-3-large
# Set to true only when you intentionally want model-suffixed vector tables
# (e.g. lightrag_vdb_chunks_text_embedding_3_large_1024d).
# Keep false to write into legacy base tables like lightrag_vdb_chunks.
LIGHTRAG_USE_EMBEDDING_MODEL_SUFFIX=false

# LightRAG embedding worker controls. Worker timeout is derived from this value.
# Example: 120s gives worker timeout ~240s (instead of default ~60s).
LIGHTRAG_EMBEDDING_TIMEOUT_SECONDS=120
LIGHTRAG_EMBEDDING_FUNC_MAX_ASYNC=4
LIGHTRAG_EMBEDDING_BATCH_NUM=4
# insert mode options: custom_chunks (recommended), single_insert
LIGHTRAG_INSERT_MODE=custom_chunks

# =============================================================================
# Ollama - Embedding Model (Alternative)
# =============================================================================
OLLAMA_MODEL_BASE_URL=http://localhost:11434
OLLAMA_MODEL_EMBEDDING_MODEL=mxbai-embed-large
OLLAMA_MODEL_EMBEDDING_MODEL_DIMS=1024
OLLAMA_MODEL_EMBEDDING_MODEL_MAX_TOKENS=8192

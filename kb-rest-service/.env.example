# =============================================================================
# KB REST SERVICE - Environment Configuration
# =============================================================================
# Multi-cloud support with canonical environment variable names
# Aligned with common_adapters package requirements
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME=KB REST Service
APP_VERSION=2.0.0
ENVIRONMENT=development  # development, staging, production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Deployment Mode
# Set to 'true' for serverless (Azure Functions, AWS Lambda, GCP Functions)
# Auto-optimizes database connection pooling
SERVERLESS=false

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # console (human-readable) or json (structured)

# -----------------------------------------------------------------------------
# Multi-Cloud Deployment
# -----------------------------------------------------------------------------
CLOUD_PROVIDER=azure  # azure, aws, gcp

# Optional overrides (defaults to CLOUD_PROVIDER)
# STORAGE_PROVIDER=azure  # azure, aws, gcp, local
# QUEUE_PROVIDER=azure    # azure, aws, redis
# OCR_PROVIDER=azure      # azure, aws, gcp, noop

# -----------------------------------------------------------------------------
# Database - PostgreSQL (Main Application)
# -----------------------------------------------------------------------------
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_USER=postgres
POSTGRESQL_PASSWORD=your-password-here
POSTGRESQL_DATABASE=kbcurator

# Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_ECHO=false

# -----------------------------------------------------------------------------
# Database - MongoDB (for common_adapters llm_router_config_store)
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DATABASE=chatbot_db

# -----------------------------------------------------------------------------
# Database - Redis
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# Redis Cache Settings
REDIS_ENABLED=true
QUERY_CACHE_TTL=3600                       # 1 hour
CONVERSATION_HISTORY_CACHE_TTL=3600        # 1 hour

# -----------------------------------------------------------------------------
# Database - Neo4j (for LightRAG Graph Storage)
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# -----------------------------------------------------------------------------
# Azure Cloud Resources
# -----------------------------------------------------------------------------
# Azure Storage (for both Blob Storage and Queue Storage)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your-storage;AccountKey=your-key;EndpointSuffix=core.windows.net

# Container/Bucket Names
STORAGE_CONTAINER_NAME=kb-documents
WORKSPACE_CONTAINER_NAME=workspace

# Queue Names
AZURE_INDEXING_QUEUE_NAME=indexing-queue

# Azure Service Bus (optional, for production)
SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://your-namespace.servicebus.windows.net/;SharedAccessKeyName=...
SERVICE_BUS_TOPIC_NAME=agent-progress
SERVICE_BUS_SUBSCRIPTION_NAME=kb-rest-service

# Azure Document Intelligence (OCR for chat file extraction)
# Note: shared/text_extraction supports both long and short forms
# Using short form as canonical
AZURE_DOC_INTELLIGENCE_ENDPOINT=https://your-instance.cognitiveservices.azure.com/
AZURE_DOC_INTELLIGENCE_KEY=your-key-here

# -----------------------------------------------------------------------------
# AWS Cloud Resources
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1

# AWS S3 Storage
S3_BUCKET_NAME=your-bucket
S3_PATH_PREFIX=kb-documents/
S3_URL_EXPIRY_MINUTES=60

# AWS SQS Queue
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/indexing-jobs
SQS_QUEUE_NAME=indexing-jobs

# AWS Textract (OCR)
AWS_TEXTRACT_REGION=us-east-1
AWS_TEXTRACT_ACCESS_KEY_ID=your-access-key
AWS_TEXTRACT_SECRET_ACCESS_KEY=your-secret-key

# -----------------------------------------------------------------------------
# GCP Cloud Resources
# -----------------------------------------------------------------------------
GCP_PROJECT_ID=your-project-id
GCP_CREDENTIALS_PATH=/path/to/credentials.json

# GCP Cloud Storage
GCS_BUCKET_NAME=your-bucket
GCS_PATH_PREFIX=kb-documents/
GCS_URL_EXPIRY_MINUTES=60

# GCP Document AI (OCR)
GCP_DOCUMENT_AI_PROJECT_ID=your-project-id
GCP_DOCUMENT_AI_LOCATION=us
GCP_DOCUMENT_AI_PROCESSOR_ID=your-processor-id
GCP_DOCUMENT_AI_CREDENTIALS_PATH=/path/to/credentials.json

# -----------------------------------------------------------------------------
# Security - JWT
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Security - CORS
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,https://your-frontend.com
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# -----------------------------------------------------------------------------
# Request Settings
# -----------------------------------------------------------------------------
MAX_REQUEST_SIZE=10485760  # 10MB

# -----------------------------------------------------------------------------
# LightRAG Configuration
# -----------------------------------------------------------------------------
LIGHTRAG_WORKING_DIR=./lightrag_data

# Storage Backend Types
VECTOR_STORAGE_TYPE=PGVectorStorage
GRAPH_STORAGE_TYPE=Neo4JStorage

# Chunk Settings
CHUNK_TOKEN_SIZE=600
CHUNK_OVERLAP_TOKEN_SIZE=150

# Embedding Settings
EMBEDDING_DIM=1024
MAX_TOKEN_SIZE=8192
EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_FUNC_MAX_ASYNC=4
EMBEDDING_BATCH_NUM=4

# -----------------------------------------------------------------------------
# LightRAG - PostgreSQL (SEPARATE from main database - can be different!)
# -----------------------------------------------------------------------------
LIGHTRAG_POSTGRESQL_HOST=your-lightrag-db.postgres.database.azure.com
LIGHTRAG_POSTGRESQL_USER=postgres
LIGHTRAG_POSTGRESQL_PASSWORD=your-password
LIGHTRAG_POSTGRESQL_DATABASE=forgex_coforge

# -----------------------------------------------------------------------------
# LightRAG - Azure OpenAI LLM (for common_adapters compatibility)
# -----------------------------------------------------------------------------
AZURE_OPENAI_LLM_MODEL_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_LLM_MODEL_API_BASE=https://your-resource.openai.azure.com/
AZURE_OPENAI_LLM_MODEL_API_VERSION=2024-02-15-preview
AZURE_OPENAI_LLM_MODEL_LLM_MODEL=gpt-4

# -----------------------------------------------------------------------------
# LightRAG - Azure OpenAI Embedding (for common_adapters compatibility)
# -----------------------------------------------------------------------------
AZURE_OPENAI_EMBEDDING_MODEL_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_EMBEDDING_MODEL_API_BASE=https://your-resource.openai.azure.com/
AZURE_OPENAI_EMBEDDING_MODEL_API_VERSION=2024-02-01
AZURE_OPENAI_EMBEDDING_MODEL_EMBEDDING_MODEL=text-embedding-3-large

# -----------------------------------------------------------------------------
# Chat Settings (for common_adapters context_compaction)
# -----------------------------------------------------------------------------
CHAT_HISTORY_TURNS_FOR_CONTEXT=5           # Previous turns to include
CHAT_CONTEXT_TOKEN_THRESHOLD=200000        # Triggers summarization

# Intent Detection
INTENT_DETECTOR_TYPE=rule  # rule, ml
INTENT_CONFIDENCE_THRESHOLD=0.8
INTENT_CACHE_ENABLED=true
INTENT_CACHE_TTL=600  # seconds

# -----------------------------------------------------------------------------
# Progress/Event Bus (optional, for agent progress tracking)
# -----------------------------------------------------------------------------
PROGRESS_BACKEND=auto  # auto, azure_service_bus, aws_eventbridge, local
EVENT_BUS_PROVIDER=azure  # azure, aws
EVENT_BUS_CONNECTION_STRING=Endpoint=sb://...
PROGRESS_TOPIC=agent-progress
PROGRESS_EVENT_BUS=default  # AWS EventBridge bus name
PROGRESS_LOCAL_RELAY_URL=http://127.0.0.1:8090/publish

# -----------------------------------------------------------------------------
# Debug Toggles
# -----------------------------------------------------------------------------
SKIP_DUPLICATE_CHECK=false

# =============================================================================
# KB REST SERVICE - Environment Configuration
# =============================================================================

# Application Settings
# -----------------------------------------------------------------------------
APP_NAME=KB REST Service
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Deployment Mode
# Set to 'true' for serverless platforms (Azure Container Apps, AWS App Runner, GCP Cloud Run)
# This automatically optimizes database connection pooling for serverless environments
SERVERLESS=false

# Logging Settings
# -----------------------------------------------------------------------------
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_FORMAT: "console" (human-readable with colors, best for dev) or "json" (structured, best for production)
LOG_LEVEL=INFO
LOG_FORMAT=json

# Database Settings - PostgreSQL
# -----------------------------------------------------------------------------
POSTGRESQL_DATABASE_HOST=localhost
POSTGRESQL_DATABASE_PORT=5432
POSTGRESQL_DATABASE_USER=postgres
POSTGRESQL_DATABASE_PASSWORD=your-password-here
POSTGRESQL_DATABASE_DATABASE=kbcurator

# Database Settings - MongoDB
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DATABASE=kb_sessions

# Database Settings - Redis
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# Database Settings - Neo4j
# -----------------------------------------------------------------------------
NEO4J_DATABASE_NEO4J_BOLT_URI=bolt://localhost:7687
NEO4J_DATABASE_NEO4J_USER=neo4j
NEO4J_DATABASE_NEO4J_PASSWORD=your-neo4j-password

# Database Connection Pool Settings
# -----------------------------------------------------------------------------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_ECHO=false

# Azure Settings
# -----------------------------------------------------------------------------
AzureWebJobsStorage=DefaultEndpointsProtocol=https;AccountName=your-storage;AccountKey=your-key;EndpointSuffix=core.windows.net
# AzureWebJobsStorage="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;QueueEndpoint=http://127.0.0.1:10001/devstoreaccount1;"
# Azure Blob Storage
BLOB_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your-storage;AccountKey=your-key;EndpointSuffix=core.windows.net
STORAGE_CONTAINER_NAME=kb-documents
WORKSPACE_CONTAINER_NAME=workspace

# Azure Queue Storage
AZURE_QUEUE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your-storage;AccountKey=your-key;EndpointSuffix=core.windows.net
AZURE_INDEXING_QUEUE_NAME=indexing-queue

# Security Settings - JWT
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Security Settings - CORS
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,https://your-frontend.com
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Request Settings
# -----------------------------------------------------------------------------
MAX_REQUEST_SIZE=10485760
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# LightRAG Settings
# -----------------------------------------------------------------------------
LIGHTRAG_WORKING_DIR=./lightrag_data
LIGHTRAG_VECTOR_STORAGE_TYPE=PGVectorStorage
LIGHTRAG_GRAPH_STORAGE_TYPE=Neo4JStorage
LIGHTRAG_CHUNK_TOKEN_SIZE=1000
LIGHTRAG_CHUNK_OVERLAP_TOKEN_SIZE=200

# LightRAG - PostgreSQL Database (for PGVectorStorage)
# -----------------------------------------------------------------------------
LIGHTRAG_POSTGRESQL_DATABASE_HOST=your-postgres-host.postgres.database.azure.com
LIGHTRAG_POSTGRESQL_DATABASE_USER=postgres
LIGHTRAG_POSTGRESQL_DATABASE_PASSWORD=your-password
LIGHTRAG_POSTGRESQL_DATABASE_DATABASE=forgex_coforge

# LightRAG - Ollama Embedding Settings
# -----------------------------------------------------------------------------
OLLAMA_MODEL_BASE_URL=http://localhost:11434
OLLAMA_MODEL_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_MODEL_EMBEDDING_MODEL_DIMS=3072
OLLAMA_MODEL_EMBEDDING_MODEL_MAX_TOKENS=8192

# LightRAG - Azure OpenAI LLM Settings
# -----------------------------------------------------------------------------
AZURE_OPENAI_LLM_MODEL_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_LLM_MODEL_API_BASE=https://your-resource.openai.azure.com/
AZURE_OPENAI_LLM_MODEL_API_VERSION=2024-02-15-preview
AZURE_OPENAI_LLM_MODEL_LLM_MODEL=gpt-4

SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://...

